{
  "manifestVersion": 1,
  "id": "prgmt-branch-creator-beta",
  "version": "0.0.0.14",
  "name": "PRGMT (New) Branch Creator",
  "description": "Use PRGMT (New) Branch Creator to create branches directly from within workitems using fields from the workitem for the branch name.",
  "publisher": "exlrstn",
  "demands": ["api-version/3.0"],
  "scopes": ["vso.work_write", "vso.code_manage"],
  "categories": ["Azure Repos"],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "content": {
    "details": {
      "path": "README.md"
    }
  },
  "icons": {
    "default": "img/branching.png"
  },
  "links": {
    "repository": {
      "uri": "https://github.com/exlrstn/easy-branch-creator"
    },
    "support": {
      "uri": "https://github.com/exlrstn/easy-branch-creator/issues"
    },
    "license": {
      "uri": "https://github.com/exlrstn/easy-branch-creator/blob/master/LICENSE"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/exlrstn/easy-branch-creator"
  },
  "screenshots": [
    {
      "path": "marketplace/create-branch-action.png"
    },
    {
      "path": "marketplace/settings.png"
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "img",
      "addressable": true
    },
    {
      "path": "marketplace",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "create-branch-from-workitem-beta",
      "type": "ms.vss-web.action",
      "description": "PRGMT (New) Branch Creator",
      "targets": ["ms.vss-work-web.work-item-context-menu"],
      "properties": {
        "text": "PRGMT (New) Branch Creator",
        "title": "PRGMT (New) Branch Creator",
        "icon": "img/branching-icon.png",
        "groupId": "actions",
        "uri": "dist/create-branch/create-branch.html"
      }
    },
    {
      "id": "branch-details-form",
      "type": "ms.vss-web.external-content",
      "description": "The details for the branch to create",
      "properties": {
        "uri": "dist/branch-details-form/branch-details-form.html"
      }
    },
    {
      "id": "settings-hub",
      "type": "ms.vss-web.hub",
      "targets": ["ms.vss-web.project-admin-hub-group"],
      "properties": {
        "name": "PRGMT (New) Branch Creator",
        "order": 10,
        "uri": "dist/settings-hub/settings-hub.html",
        "icon": "img/branching-icon.png"
      }
    }
  ]
}
